{
  "name": "Daily Calendar Agenda to Slack",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "e6f7a8b9-0001-4000-8000-000000000001",
      "name": "Weekday Mornings 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_CALENDAR"
        },
        "returnAll": true,
        "options": {
          "timeMin": "={{ $now.toISO() }}",
          "timeMax": "={{ $now.endOf('day').toISO() }}",
          "singleEvents": true
        }
      },
      "id": "e6f7a8b9-0002-4000-8000-000000000002",
      "name": "Get Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json);\nif (!events.length || !events[0].id) {\n  return [{ json: { agenda: ':sunny: No meetings today. Deep work day!' } }];\n}\nconst lines = events\n  .sort((a, b) => new Date(a.start?.dateTime || a.start?.date) - new Date(b.start?.dateTime || b.start?.date))\n  .map(e => {\n    const link = e.hangoutLink || (e.location && e.location.startsWith('http') ? e.location : null);\n    if (!e.start?.dateTime) return `- *All day:* ${e.summary}`;\n    const t = new Date(e.start.dateTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n    return `- *${t}* ${e.summary}${link ? ` (<${link}|join>)` : ''}`;\n  });\nreturn [{ json: { agenda: `:calendar: *Today's agenda*\\n${lines.join('\\n')}` } }];"
      },
      "id": "e6f7a8b9-0003-4000-8000-000000000003",
      "name": "Format Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_CHANNEL"
        },
        "text": "={{ $json.agenda }}",
        "otherOptions": {}
      },
      "id": "e6f7a8b9-0004-4000-8000-000000000004",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Weekday Mornings 8am": {
      "main": [
        [
          {
            "node": "Get Today's Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Today's Events": {
      "main": [
        [
          {
            "node": "Format Agenda",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Agenda": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}